# ==============================================================================
# RIVET Streaming Server Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================
# All parameters are dynamically loaded at runtime without recompilation.
# Precedence: CLI Options > Shell Environment Variables > .env File > Defaults

# ------------------------------------------------------------------------------
# [Network & Signaling]
# ------------------------------------------------------------------------------
# RTSP TCP control plane listening port
RIVET_RTSP_PORT=8554

# Default stream mount identifier (accessed via rtsp://<server>:<port>/<name>)
RIVET_STREAM_NAME=live/test

# Number of isolated EgressReactor shard threads per worker
RIVET_EGRESS_SHARDS=2

# Base dedicated UDP port pair for egress reactor shards (rtp: 20000+2i, rtcp: 20001+2i)
RIVET_BASE_RTP_PORT=20000
RIVET_BASE_RTCP_PORT=20001

# Supervisor health check and worker watchdog interval in milliseconds
RIVET_WATCHDOG_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# [Memory & Slab Allocator Pool]
# ------------------------------------------------------------------------------
# NUMA Arena capacity (total number of pre-allocated 64-byte aligned slabs)
# 4096 slabs * 2048 bytes = 8 MB default contiguous slab memory pool
RIVET_NUMA_CAPACITY=4096

# Fixed slab buffer size in bytes (accommodates 1500 MTU + RTP/IP headers)
RIVET_NUMA_SLAB_SIZE=2048

# Maximum aggregate memory quota per EgressReactor before dropping (16 MB)
RIVET_MAX_REACTOR_BYTES=16777216

# Maximum queue depth (packets) per subscriber session before disconnect/drop
RIVET_MAX_PENDING_SENDS=512

# ------------------------------------------------------------------------------
# [Policies & Media Delivery]
# ------------------------------------------------------------------------------
# Startup policy for newly connected subscribers:
# - FreshnessFirst (Recommended for live cameras): Discards backlog and starts directly at live edge
# - FastStartup: Bursts retained RAP/keyframe and SPS/PPS for instant video display
RIVET_STARTUP_POLICY=FreshnessFirst

# Backpressure and congestion drop policy:
# - DependencyAware: Intelligently drops disposable B-frames first before P/I frames
# - Aggressive: Drops non-keyframe packets when queue depth spikes
RIVET_DROP_POLICY=DependencyAware

# Logging verbosity level: INFO, DEBUG, WARN
RIVET_LOG_LEVEL=INFO
